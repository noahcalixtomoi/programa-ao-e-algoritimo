#include <iostream>
using namespace std;

int main() {
    int vetor[10];

    cout << "Digite 10 numeros:" << endl;
    for (int i = 0; i < 10; i++) {
        cin >> vetor[i];
        if (vetor[i] < 0) {
            vetor[i] = 0; // Substituição
        }
    }

    cout << "Vetor resultante: ";
    for (int i = 0; i < 10; i++) {
        cout << vetor[i] << " ";
    }
    cout << endl;

    return 0;
}
